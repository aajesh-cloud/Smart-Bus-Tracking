# ==============================================================================
# Smart Bus Tracking — Backend (.env.example)
# Copy this file to `.env` in the same folder and fill in your real values.
# NEVER commit the real `.env` file — it contains secrets.
# ==============================================================================

# —— Server ———————————————————————————————————————————————————————————————————
PORT=5000
NODE_ENV=development

# —— CORS (comma-separated list of allowed origins, no trailing slashes) —————
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Example with production:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-passenger-app.vercel.app,https://your-driver-app.vercel.app

# —— MongoDB Atlas ———————————————————————————————————————————————————————————
# Two equivalent URIs are provided.  Try Option 1 first; if DNS SRV lookups
# fail on your network (mobile hotspot / strict ISP / college WiFi), fall
# back to Option 2 (explicit 3-shard list with NO SRV resolution needed).
#
# To get YOUR exact strings, in MongoDB Atlas UI:
#   Clusters → Connect → Connect your application → Driver: Node.js
#
# OPTION 1 — mongodb+srv:// (clean)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.<id>.mongodb.net/smart_bus_tracking?retryWrites=true&w=majority&appName=<ClusterName>
#
# OPTION 2 — Standard mongodb:// with explicit shard hosts (bulletproof)
#   To discover the 3 shard hostnames for YOUR cluster, run:
#     nslookup -type=SRV _mongodb._tcp.<cluster-name>.<id>.mongodb.net
#   Then replace the 3 ac-xxxx-shard-00-XX hostnames below, and also update
#   replicaSet=atlas-xxxx-shard-0 to match the "atlas-" prefix from the hosts.
MONGO_URI=mongodb://<username>:<password>@ac-xxxxx-shard-00-00.<id>.mongodb.net:27017,ac-xxxxx-shard-00-01.<id>.mongodb.net:27017,ac-xxxxx-shard-00-02.<id>.mongodb.net:27017/smart_bus_tracking?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority

# —— JWT Authentication ——————————————————————————————————————————————————————
# Use a long, random string (e.g. output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_me_with_a_very_long_random_string_please
JWT_EXPIRES_IN=7d

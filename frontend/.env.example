# ==============================================================================
# Smart Bus Tracking — Passenger Frontend (.env.example)
# Copy this file to `.env` in the same folder and fill in your real values.
# NEVER commit the real `.env` file — the URLs are not secret but Vite reads
# them at build time, and keeping them here avoids hard-coding platform URLs.
# ==============================================================================

# —— Backend API ——————————————————————————————————————————————————————————————
# Local development (backend on port 5000):
VITE_API_URL=http://localhost:5000/api
# Production (point at your Render / Railway / self-hosted backend):
# VITE_API_URL=https://smart-bus-tracking-abpb.onrender.com/api

# —— Socket.IO ————————————————————————————————————————————————————————————————
# Same host/port as the backend (without /api suffix):
VITE_SOCKET_URL=http://localhost:5000
# Production:
# VITE_SOCKET_URL=https://smart-bus-tracking-abpb.onrender.com
